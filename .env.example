# ---------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored; this file is not.
# ---------------------------------------------------------------

# ---- Postgres (docker-compose reads these) ----
POSTGRES_USER=vish
POSTGRES_PASSWORD=vish_dev_password
POSTGRES_DB=vish_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vish:vish_dev_password@localhost:5432/vish_ai

# ---- Ollama (local models) ----
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_MODEL=qwen3:8b
DEEP_CHAT_MODEL=qwen3:14b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- Anthropic (optional cloud escape hatch; blank = disabled) ----
ANTHROPIC_API_KEY=
CLOUD_CHAT_MODEL=claude-sonnet-5

# ---- Backend ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Single-user mode (auth deferred to M9) ----
LOCAL_USER_EMAIL=local@localhost
LOCAL_USER_NAME=Vishnu

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
